{
  "name": "digital-evolution-ecosystem",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm exec tsc -p packages/contracts/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p packages/sim-core/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p packages/sim-analysis/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p packages/sim-decisions/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p packages/sim-runtime/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p packages/phenotype/tsconfig.json --noEmit --pretty false && pnpm exec tsc -p apps/explorer/tsconfig.json --noEmit --pretty false",
    "build": "pnpm --filter @digital-evolution/explorer build && tsx tools/validation/provenance-build.ts",
    "dev": "pnpm --filter @digital-evolution/explorer dev",
    "verify": "tsx tools/validation/run.ts verify",
    "verify:fast": "tsx tools/validation/run.ts group fast",
    "verify:simulation": "tsx tools/validation/run.ts group simulation",
    "verify:presentation": "tsx tools/validation/run.ts group presentation",
    "verify:browser": "tsx tools/validation/run.ts group browser",
    "verify:evidence": "tsx tools/validation/run.ts group evidence",
    "verify:survey": "tsx tools/validation/run.ts group survey",
    "ci:group": "tsx tools/validation/run.ts group",
    "validation:check": "tsx tools/validation/run.ts check",
    "validation:plan": "tsx tools/validation/run.ts plan",
    "validation:merge": "tsx tools/validation/run.ts merge",
    "test:migration": "tsx tools/validation/parity.ts",
    "test:ecology": "tsx tools/validation/ecology.ts",
    "test:survey": "tsx tools/validation/ecology-survey.ts",
    "test:browser": "tsx tools/validation/browser-smoke.ts",
    "test:decisions": "tsx tools/validation/decisions.ts",
    "test:catalysts": "tsx tools/validation/catalysts.ts",
    "test:flows": "tsx tools/validation/flows.ts",
    "test:dependency": "tsx tools/validation/dependency.ts",
    "test:dependency:fast": "tsx tools/validation/dependency.ts -- --fast",
    "test:dependency:arc": "tsx tools/validation/dependency.ts -- --skip-policy --only=arc,checkpoint",
    "test:dependency:washout": "tsx tools/validation/dependency.ts -- --skip-policy --only=washout",
    "test:catalysts:fast": "tsx tools/validation/catalysts.ts -- --fast",
    "test:niche": "tsx tools/validation/niche.ts",
    "test:niche-survey": "tsx tools/validation/niche-survey.ts",
    "test:washout-reliance": "tsx tools/validation/washout-reliance.ts",
    "test:phenotype": "tsx tools/validation/phenotype.ts && tsx tools/validation/phenotype-world.ts",
    "test:landscape": "tsx tools/validation/landscape.ts",
    "test:aftermath": "tsx tools/validation/aftermath.ts && tsx tools/validation/aftermath-runtime.ts",
    "test:visual": "tsx tools/validation/landscape-capture.ts",
    "test:mobile-ui": "tsx tools/validation/mobile-ui.ts",
    "test:time-controls": "tsx tools/validation/time-controls.ts",
    "test:art-review": "tsx tools/validation/art-review.ts",
    "test:validation-arch": "tsx tools/validation/validation-arch.ts",
    "test:runtime-boundary": "tsx tools/validation/runtime-boundary.ts",
    "test:interference": "tsx tools/validation/interference.ts",
    "test:plated": "tsx tools/plated-proof/validate.ts && tsx tools/plated-proof/geo-validate.ts",
    "test:pixi-spike": "tsx tools/pixi-spike/validate.ts",
    "test:pixi-p0": "tsx tools/validation/pixi-p0.ts",
    "test:pixi-world": "tsx tools/pixi-world-proof/capture.ts",
    "test:provenance": "tsx tools/validation/provenance.ts",
    "test:broad-ecology-022": "tsx tools/validation/broad-ecology-022.ts",
    "test:broad-ecology-022-summary": "tsx tools/validation/broad-ecology-022-summary.ts",
    "spike:capture": "tsx tools/pixi-spike/capture.ts",
    "spike:dev": "pnpm --filter @digital-evolution/explorer exec vite ../../tools/pixi-spike --port 5193 --strictPort --host 127.0.0.1",
    "test:dependency:possibility": "tsx tools/validation/dependency.ts -- --skip-policy --only=possibility",
    "test:dependency:tradeoff": "tsx tools/validation/dependency.ts -- --skip-policy --only=tradeoff",
    "validation:graph": "tsx tools/validation/run.ts graph",
    "ci:shard": "tsx tools/validation/run.ts ci",
    "ci:plan": "tsx tools/validation/run.ts shard-plan"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "pixi.js": "^8.21.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
