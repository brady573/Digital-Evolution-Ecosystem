{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-ai overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overrides"],
  "properties": {
    "schema": {"const": "repo-ai/overrides/v1"},
    "overrides": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {"type": "array", "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"},
            "level": {"enum": ["guidance", "check", "enforce"]},
            "requirement": {"type": "string", "minLength": 1},
            "reason": {"type": "string"}
          }
        }}
      ]
    }
  }
}
