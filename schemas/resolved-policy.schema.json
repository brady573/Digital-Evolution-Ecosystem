{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-ai ResolvedPolicy v1",
  "description": "Effective policy after baseline, detected-stack, repository-standard, and explicit-override resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "digest", "rules"],
  "properties": {
    "schema": {"const": "repo-ai/resolved/v1"},
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Resolved-policy digest over canonical effective rule definitions in rule-ID order. Excludes provenance and environment-specific metadata."
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definition", "provenance"],
        "properties": {
          "definition": {"$ref": "policy.schema.json#/$defs/rule"},
          "provenance": {"type": "array", "items": {
            "type": "object",
            "required": ["source"],
            "properties": {"source": {"type": "object", "required": ["layer", "name"]}}
          }}
        }
      }
    }
  }
}
