  "required": ["languages", "packageManagers", "frameworks", "testRunners", "linters", "formatters", "ciSystems", "monorepo", "workspacePaths"],
  "properties": {
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "packageManagers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "frameworks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "testRunners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "linters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "formatters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ciSystems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "monorepo": {"type": "boolean"},
    "workspacePaths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
