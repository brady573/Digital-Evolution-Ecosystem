{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-ai policy pack lock v1",
  "description": "Pins the integrity digest of each individual policy pack. This is distinct from the digest of the resolved effective policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packs"],
  "properties": {
    "schema": {"const": "repo-ai/lock/v1"},
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "version", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "description": "Policy-pack integrity digest for this individual pack's canonical contents."
          }
        }
      }
    }
  }
}
