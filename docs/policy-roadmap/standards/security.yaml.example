schema: repo-ai/v1
rules:
  - id: security.no-secrets
    level: enforce
    scope: "**"
    requirement: repository_must_not_contain_obvious_secrets

  - id: security.least-privilege-ci
    level: enforce
    scope: ".github/workflows/**"
    requirement: github_actions_least_privilege

  - id: security.no-control-weakening
    level: enforce
    scope: "**"
    instruction: >
      Do not weaken security controls merely to make a change pass.
